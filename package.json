{
  "name": "writing-coach-grammar-tool",
  "displayName": "Writing Coach Grammar Tool",
  "version": "1.0.0",
  "description": "Chrome and Firefox writing assistant that suggests grammar, clarity, style, and tone improvements locally.",
  "author": "",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "build:chrome": "plasmo build --target=chrome-mv3",
    "build:firefox": "plasmo build --target=firefox-mv2"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.285",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "plasmo": "0.90.3",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  },
  "plasmo": {
    "manifest": {
      "name": "Writing Coach Grammar Tool",
      "description": "Improve grammar, clarity, style, and tone in editable fields across the web.",
      "permissions": [
        "storage"
      ],
      "host_permissions": [
        "<all_urls>"
      ]
    }
  }
}
